# ─────────────────────────────────────────────────
#  .env — Agendamento System
#  Copie este arquivo para .env e preencha os valores
#  NUNCA commite o .env no GitHub (já está no .gitignore)
# ─────────────────────────────────────────────────

# Porta local de desenvolvimento (Railway define automaticamente)
PORT=3000

# Proteção da aplicação interna. Use valor aleatório com 32+ caracteres.
SESSION_SECRET=troque-por-um-segredo-de-assinatura-forte
SESSION_TTL_HOURS=12
ALLOWED_ORIGINS=https://sistema.oticastgt.com.br,https://sistema-production-cd20.up.railway.app

# Chave usada para criptografar (AES-256-GCM) segredos salvos no banco pelo
# painel de Configurações (ex.: access token do Kommo). Sem esta chave, o
# Admin não consegue salvar credenciais do Kommo pela tela — o sistema
# continua funcionando normalmente com as variáveis de ambiente abaixo.
CONFIG_ENCRYPTION_KEY=troque-por-um-segredo-de-32-ou-mais-caracteres

# Kommo / Salesbot
KOMMO_SUBDOMAIN=oticastargetcontato
KOMMO_ACCESS_TOKEN=cole-o-token-de-acesso-do-kommo
KOMMO_USE_SALESBOT=true
BOT_ENABLED=true
SALESBOT_SECRET=gere-um-segredo-forte-para-o-salesbot
KOMMO_WEBHOOK_SECRET=gere-um-segredo-forte-para-o-webhook

# Lembretes automáticos de agendamento
REMINDER_AUTOMATION_ENABLED=true
REMINDER_HOUR=8
REMINDER_2H_AUTOMATION_ENABLED=true
REMINDER_2H_INTERVAL_MINUTES=5

# Mapa de estagios por pipeline — gerado pelo endpoint POST /api/admin/kommo/setup-stages
# Cole o valor retornado pelo endpoint no campo env_var
KOMMO_STAGES_MAP={}

# (Opcional) Timeout em minutos antes do bot retomar controle apos atendente humano
BOT_HUMAN_TIMEOUT_MIN=5
BOT_HUMAN_RESUME_MIN=60

# (Legado) Estagios individuais — use KOMMO_STAGES_MAP no lugar
KOMMO_STAGE_AGENDAR=
KOMMO_DEFAULT_RESPONSIBLE_ID=

# Desempenho de anúncios (AdAnalyzer → github-sistema → fase2)
# ADANALYZER_SYNC_KEY: chave que o AdAnalyzer usa para enviar (POST) o gasto diário por loja.
# FASE2_API_KEY: chave que o sistema fase2 (Next.js) usa para ler (GET) esses dados sem sessão de navegador.
ADANALYZER_SYNC_KEY=gere-uma-chave-forte-para-o-adanalyzer
FASE2_API_KEY=gere-uma-chave-forte-para-o-fase2

# Captação de leads (captacao-leads-tgt → github-sistema)
# CAPTACAO_SYNC_KEY: chave que a captação usa para resolver/criar o ID de
# vendedor/consultor via POST /api/internal/vendedores-consultores/resolve.
CAPTACAO_SYNC_KEY=gere-uma-chave-forte-para-a-captacao
